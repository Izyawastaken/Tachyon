{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tachyon",
  "identifier": "com.izya.tachyon",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tachyon",
        "width": 800,
        "height": 600,
        "decorations": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3MkE4MUVCQTNENUYzNEIKUldSTDg5V2o2NEVxOXhRK01iMTlqSXlBK1IvaUR4dW0wek1CRkdwaHlxUnRab3NWRXNiaHpwb1oK",
      "requireSignedVersion": true
    }
  }
}